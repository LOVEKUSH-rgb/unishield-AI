{
  "title": "UniShield SOC Overview",
  "uid": "unishield-overview",
  "panels": [
    {
      "type": "stat",
      "title": "API Up",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=\"unishield-api\"}"}]
    },
    {
      "type": "stat",
      "title": "Events Received / sec",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "unishield:ingestion_events_per_second"}]
    },
    {
      "type": "timeseries",
      "title": "Database Operations / sec",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"expr": "rate(unishield_database_operations_total[1m])"}]
    },
    {
      "type": "timeseries",
      "title": "Detector Latency P95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(unishield_detector_latency_seconds_bucket[1m])) by (le, detector_name))", "legendFormat": "{{detector_name}}"}]
    }
  ],
  "schemaVersion": 38,
  "timezone": "browser"
}
