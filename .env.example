# ============================================================
# UniShield AI — Environment Configuration
# ============================================================
# IMPORTANT: This is an example file.
# Do NOT place real production secrets here.
# Copy this file to `.env` and adjust values accordingly.
# ============================================================

ENVIRONMENT=development

# ------------------------------------------------------------
# Database Settings (PostgreSQL)
# ------------------------------------------------------------
POSTGRES_USER=unishield_dev
POSTGRES_PASSWORD=unishield_dev_password
POSTGRES_DB=unishield
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# Redis Settings
# ------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=unishield_redis_dev
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ------------------------------------------------------------
# Security Settings
# ------------------------------------------------------------
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=development-only-change-me-immediately
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:8501
