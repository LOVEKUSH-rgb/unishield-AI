# UniShield AI — Dashboard Dockerfile
FROM python:3.12-slim

LABEL maintainer="UniShield AI Team"
LABEL description="UniShield AI Dashboard"

# Create a non-root user
RUN groupadd -r unishield && useradd -m -r -g unishield unishield

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY . .

# Change ownership to non-root user
RUN chown -R unishield:unishield /app

USER unishield

ENV PYTHONPATH=/app

EXPOSE 8501

CMD ["python", "-m", "streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
